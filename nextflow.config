params {
  // conda
  useConda = true

  // core inputs
  features   = 'data/SampleDataset/Features_Sample.csv'
  meta       = 'data/SampleDataset/Metadata_Sample.csv'
  covariates = 'diversity_shannon,Incidence,Density'
  outdir     = 'MLTBdx_mwmoteTBSample'

  // modeling grid
  norms   = 'rank.unit,rank.std,log.std,log.unit,log.clr,std'
  cutoffs = '0.0001, 0.0005, 0.001, 0.005, 0.01'
  models  = 'randomForest,lasso,lasso_ll,enet,ridge,ridge_ll'

  // Evaluation metric of choice
  sel_metric = 'mcc'

  // Top model selection 
  balance_lambdas        = [0.3, 0.4, 0.5]
  shap_model_ids         = ''
  fold_metrics_threshold = 0.5

  // interpretation plot consensus for randomForest
  rf_consens_thresh = 0.01

  // labels / IDs
  label_column = 'Disease_Status'
  case_label   = 'TB_case'
  taxa_col     = 'Genus'
  meta_id_col  = 'SampleID'
  meta_ids_are_colnames = false

  // SHAP
  shap_nsim   = 100
  shap_sample = 200
  shap_mtry   = 18
  shap_trees  = 1000
  shap_alpha  = 0.5
  shap_thresh = 0.5

  // validation inputs (optional; can be null if unused)
  val_features    = 'data/SampleDataset/Validation_Features_Sample.csv'
  val_meta        = 'data/SampleDataset/Validation_Metadata_Sample.csv'
  label_col       = 'Disease_Status'
  val_feat_id_col = 'GENUS'
}


process {
  cpus = '16'
  memory = '64 GB'
  errorStrategy = 'retry'
  maxRetries = 1
//  scratch = true
}

profiles {
  docker {
    docker.enabled = true
  }
  conda {
        process {
      // make all processes use this env by default
      conda = 'envs/r-siamcat.yml'
    }
    conda.enabled = true
  }
}

timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/timeline.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/trace.txt"
}

report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/report.html"
}
